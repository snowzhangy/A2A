# Local caches: models, consented/licensed evaluation audio, run directories, apps.
.local/
# Per-machine runtime captures/inventories; publish aggregate reports instead.
reports/week2/raw/

# Swift
apple/.build/
apple/.swiftpm/
*.xcuserstate
xcuserdata/
DerivedData/

# Python
harness/.venv/
research/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw participant audio, transcripts, voice prompts, and full text traces never go in git.
*.participant.*
fixtures/**/*.wav
!fixtures/contract/**/*.wav

.DS_Store

# A tool run from the repo root with no --trace / --out path writes its output here. Keep the
# tree clean; real runs point at .local/ (see AGENTS.md "Commands").
/trace.jsonl
/trace*.jsonl
/:memory:.ses
/out.wav
/source.wav
