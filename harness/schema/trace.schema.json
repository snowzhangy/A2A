{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a.dev/schema/trace/v0",
  "title": "A2A trace event v0 (one JSON object per line)",
  "description": "IMPLEMENTATION_PLAN.md section 4.5. Spans are half-open canonical 48 kHz source samples; t_ns is host monotonic time.",
  "type": "object",
  "required": ["v", "t_ns", "session", "epoch", "gen", "ev"],
  "properties": {
    "v": {"const": 0},
    "t_ns": {"type": "integer", "minimum": 0},
    "session": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "gen": {"type": "integer", "minimum": 0},
    "ev": {
      "enum": [
        "session.start", "buf.capture", "buf.output", "state.change", "vad.start", "vad.end",
        "spk.assign", "spk.change", "profile.ready", "asr.partial", "asr.final", "commit.source",
        "mt.request", "mt.result", "commit.target", "tts.request", "tts.first_chunk", "tts.chunk",
        "play.scheduled", "play.start", "play.end", "unit.cancel", "source.disposition", "queue.depth",
        "clock.drift", "resource.sample", "fallback.enter", "fallback.exit", "trace.drop", "error",
        "commit.hold", "commit.revision", "pcm.reject", "gain.ramp", "asr.finalize_request", "catch_up",
        "tts.done"
      ]
    },
    "span": {"$ref": "#/$defs/span"},
    "unit": {"$ref": "#/$defs/unit"},
    "spk": {"type": "string"},
    "prof": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "out_sample": {"type": "integer", "minimum": 0},
    "src_sample": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "minItems": 2,
      "maxItems": 2
    },
    "unit": {"type": "string", "pattern": "^u[0-9]+$"},
    "disposition": {"enum": ["translated", "original_only", "abandoned", "never_committed", "uncertain_overlap", "repeated_handoff", "inaudible"]}
  },
  "allOf": [
    {"if": {"properties": {"ev": {"const": "buf.capture"}}},
     "then": {"required": ["span", "frames"]}},
    {"if": {"properties": {"ev": {"const": "buf.output"}}},
     "then": {"required": ["out_sample", "frames"]}},
    {"if": {"properties": {"ev": {"const": "state.change"}}},
     "then": {"required": ["from", "to", "reason"]}},
    {"if": {"properties": {"ev": {"enum": ["vad.start", "vad.end"]}}},
     "then": {"required": ["src_sample"]}},
    {"if": {"properties": {"ev": {"enum": ["spk.assign"]}}},
     "then": {"required": ["spk", "span"]}},
    {"if": {"properties": {"ev": {"const": "profile.ready"}}},
     "then": {"required": ["spk", "prof"]}},
    {"if": {"properties": {"ev": {"enum": ["asr.partial", "asr.final"]}}},
     "then": {"required": ["span"]}},
    {"if": {"properties": {"ev": {"const": "commit.source"}}},
     "then": {"required": ["unit", "spk", "span", "reason", "timing_estimated", "wait_ms"]}},
    {"if": {"properties": {"ev": {"enum": ["mt.request", "tts.request", "play.scheduled", "unit.cancel", "fallback.exit"]}}},
     "then": {"required": ["unit"]}},
    {"if": {"properties": {"ev": {"const": "mt.result"}}},
     "then": {"required": ["unit", "ok"]}},
    {"if": {"properties": {"ev": {"const": "commit.target"}}},
     "then": {"required": ["unit", "spk", "span"]}},
    {"if": {"properties": {"ev": {"enum": ["tts.first_chunk", "tts.chunk"]}}},
     "then": {"required": ["unit", "frames", "rate"]}},
    {"if": {"properties": {"ev": {"enum": ["play.start", "play.end"]}}},
     "then": {"required": ["unit", "out_sample"]}},
    {"if": {"properties": {"ev": {"const": "source.disposition"}}},
     "then": {"required": ["disposition"], "properties": {"disposition": {"$ref": "#/$defs/disposition"}}}},
    {"if": {"properties": {"ev": {"const": "queue.depth"}}},
     "then": {"required": ["debt_ms", "oldest_source_age_ms"]}},
    {"if": {"properties": {"ev": {"const": "clock.drift"}}},
     "then": {"required": ["ratio"]}},
    {"if": {"properties": {"ev": {"const": "resource.sample"}}},
     "then": {"required": ["process"]}},
    {"if": {"properties": {"ev": {"const": "fallback.enter"}}},
     "then": {"required": ["reason"]}},
    {"if": {"properties": {"ev": {"const": "trace.drop"}}},
     "then": {"required": ["count"]}},
    {"if": {"properties": {"ev": {"const": "error"}}},
     "then": {"required": ["where"]}},
    {"if": {"properties": {"ev": {"const": "pcm.reject"}}},
     "then": {"required": ["unit", "reason"]}},
    {"if": {"properties": {"ev": {"const": "gain.ramp"}}},
     "then": {"required": ["original", "translated", "ms"]}},
    {"if": {"properties": {"ev": {"const": "catch_up"}}},
     "then": {"required": ["units", "debt_ms", "oldest_source_age_ms"]}},
    {"if": {"properties": {"ev": {"const": "tts.done"}}},
     "then": {"required": ["unit", "pace", "native_ms", "audio_ms"]}}
  ]
}
